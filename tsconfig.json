{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "typeRoots": ["../tsonic/node_modules/@types"],
    "strict": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "nodejs/src",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@tsonic/target-mojo": ["../tsonic-mojo/dist/index.d.ts"],
      "@tsonic/target-mojo/*": ["../tsonic-mojo/dist/public/*.d.ts"]
    }
  },
  "include": ["nodejs/src/**/*.ts"]
}
